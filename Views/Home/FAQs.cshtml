<!--Written by Josh Green-->
<!--This page is for frequently asked questions about the Meva application-->

@{

    ViewBag.Title = "FAQs";
    int index = 0;
}



<div class="row">
    <partial name="SideMenu" />

    <!--Main Content-->
    <div class="col mt-3">
        <div class="text-center">

            <h1 class="display-4 mb-3 mb-md-5">Frequently Asked Questions</h1>

            <div class="accordion text-start col-8 offset-2" id="faq-accordian">

                @foreach(var q in StaticData.FAQs)
                {
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#@index" aria-expanded="true" aria-controls="collapseOne">
                                @q.Key
                            </button>
                        </h2>
                        <div id="@index" class="accordion-collapse collapse" data-bs-parent="#faq-accordian">
                            <div class="accordion-body">
                                @q.Value
                            </div>
                        </div>
                    </div>

                    @if(true)
                    {
                        index++;
                    }


                }

                <!--Add a section for a user to submit a question.-->

            </div>


        </div>
    </div>
</div>