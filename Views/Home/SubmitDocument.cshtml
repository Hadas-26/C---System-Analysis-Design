@model SubmitDocumentViewModel


@{
    ViewBag.Title = "Submit Documents";
}

<div class="row">
    <div class="col-12 text-center mb-5">
        <h3>Submit Additional Documentation</h3>
    </div>
    <div class="col">
        <form method="post" asp-action="SubmitDocument" enctype="multipart/form-data" class="col-6 offset-3">
            <input asp-for="ApplicationId" value="@Model.ApplicationId" type="hidden" />
            <div class="row mb-3">
                <input type="file" id="documentation" asp-for="Documents" multiple accept=".pdf, .jpg, .jpeg, .png" class="form-control">
            </div>
            <div id="fileList" class="mt-2"></div>

            <div class="row">
                <div class="col">
                    <button type="submit" class="btn btn-primary">Submit</button>
                    <a asp-action="CheckStatus" asp-controller="Home" class="btn btn-outline-primary">Cancel</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/document_handler.js" asp-append-version="true"></script>
}