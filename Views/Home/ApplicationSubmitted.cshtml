<!--This page is displayed when an application is successfully submitted through the Apply.cshtml page-->

@{

    ViewBag.Title = "Home Page";

}

<div class="row">
    <partial name="SideMenu" />


    <div class="col mt-3">
        <div class="text-center">
            <h1 class="display-4 mb-3 mb-md-5 text-success">Application Submitted Successfully!</h1>
            <p class="text-muted">Check your application status frequently to see whether you've been approved or not. The review process can take several weeks.</p>
        </div>

        <div class="row">
            <div class="col-4 text-center">
                <a class="btn btn-primary" asp-action="Index" asp-controller="Home">Home</a>
            </div>
        </div>
    </div>
</div>