@model ApplyModel

@{

    ViewBag.Title = "Apply";

}




<div class="text-center mt-5 mb-5">
    <h1>Medicaid Application Form</h1>
</div>



<div class="row justify-content-center">
    <div class="col-8 offset-2 offset-md-0 col-md-10 col-lg-8">
        <div asp-validation-summary="All" class="text-danger"></div>
        <form asp-action="Apply" method="post" enctype="multipart/form-data">

            <div class="row g-3 mb-3">

                <div class="col">
                    <div class="form-floating">
                        <input type="text" asp-for="FirstName" id="FirstNamed" class="form-control" required>
                        <label asp-for="FirstName">First Name</label>
                    </div>
                </div>

                <div class="col col-sm-2">
                    <div class="form-floating">
                        <input type="text" id="MiddleInitial" asp-for="MiddleInitial" class="form-control" required>
                        <label asp-for="MiddleInitial">Middle Initial</label>
                    </div>
                </div>

                <div class="col">
                    <div class="form-floating">
                        <input type="text" id="LastNamed" asp-for="LastName" class="form-control" required>
                        <label asp-for="LastName">Last Name</label>
                    </div>
                </div>

                        
            </div>

            <div class="row g-1 mb-3">
                <div class="col">
                    <div class="form-floating">
                        <input type="text" id="Address" asp-for="StreetAddress" class="form-control" required>
                        <label asp-for="StreetAddress">Address</label>
                    </div>
                </div>
            </div>

                    
            <div class="row g-3 mb-3">

                <div class="col-sm-7">
                    <div class="form-floating">
                        <input type="text" id="City" asp-for="City" class="form-control" required>
                        <label asp-for="City">City</label>
                    </div>
                </div>

                <div class="col">
                    <div class="form-floating">
                        <input type="text" id="State" asp-for="State" class="form-control" required>
                        <label asp-for="State">State</label>
                    </div>
                </div>

                <div class="col">
                    <div class="form-floating">
                        <input type="text" id="ZipCode" asp-for="ZipCode" class="form-control" required>
                        <label asp-for="ZipCode">Zip Code</label>
                    </div>
                </div>
            </div>

                        
            <div class="row g-2 mb-3">

                <div class="col-sm-5">
                    <div class="form-floating">
                        <input type="tel" id="PhoneNumber" asp-for="PhoneNumber" class="form-control" required>
                        <label asp-for="PhoneNumber">Phone Number</label>
                    </div>
                </div>

                <div class="col">
                    <div class="form-floating">
                        <input type="email" id="Email" asp-for="EmailAddress" class="form-control" required>
                        <label asp-for="EmailAddress">Email</label>
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col col-sm-9">
                    <div class="form-floating">
                        <select id="VolunteerStatus" asp-for="VolunteerStatus" class="form-select" required>
                            <option value="">Volunteer Status</option>
                            <option value="Active">Currently Volunteering</option>
                            <option value="Inactive">Not Currently Volunteering</option>
                        </select>
                        <label asp-for="VolunteerStatus" class="form-label visually-hidden">Volunteer Status</label>
                    </div>
                </div>

                <div class="col d-none" id="VolunteerHoursField">
                    <div class="form-floating">
                        <input type="number" id="VolunteerHours" asp-for="VolunteerHours" class="form-control" min="0">
                        <label asp-for="VolunteerHours" class="form-label">Monthly Hours</label>
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-9 mb-3 mb-md-0">
                    <div class="form-floating">
                        <select id="EmploymentStatus" asp-for="EmploymentStatus" class="form-select" required>

                            <option value="">Employment Status</option>
                            <option value="EmployedHalftime">Employment (Half-time)</option>
                            <option value="EmployedFulltime">Employment (Full-time)</option>
                            <option value="Unemployed">Unemployed</option>
                            <option value="Retired">Retired</option>
                        </select>
                        <label asp-for="EmploymentStatus" class="form-label visually-hidden">Employment Status</label>
                    </div>
                </div>

                <div class="col d-none" id="EmploymentField">
                    <div class="form-floating">
                        <input type="number" id="MonthlyIncome" asp-for="EmploymentHours" step="0.01" class="form-control" min="0">
                        <label asp-for="EmploymentHours" class="form-label">Monthly Income</label>
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-9 mb-3 mb-md-0">
                    <div class="form-floating">
                        <select id="EducationStatus" asp-for="EducationStatus" class="form-select" required>
                            <option value="">Education Status</option>
                            <option value="FullTime">Attending Full-time</option>
                            <option value="PartTime">Attending Part-time</option>
                            <option value="NotAttending">Not Attending</option>
                        </select>
                        <label asp-for="EducationStatus" class="form-label visually-hidden">Education Status</label>
                    </div>
                </div>

                <div class="col d-none" id="EducationField">
                    <div class="form-floating">
                        <input type="number" id="CreditHours" asp-for="EducationHours" step="1" class="form-control" min="0">
                        <label asp-for="EducationHours" class="form-label">Credit Hours</label>
                    </div>
                </div>
            </div>

            <div class="row mb-3">

                <div class="form-floating">
                    <select id="MaritalStatus" asp-for="MaritalStatus" class="form-select" required>
                        <option value="">Marital Status</option>
                        <option value="Single">Single</option>
                        <option value="Married">Married</option>
                        <option value="Divorced">Divorced</option>
                        <option value="Widowed">Widowed</option>
                    </select>
                    <label asp-for="MaritalStatus" class="form-label visually-hidden">Marital Status</label>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col">
                    <input type="checkbox" id="DisabledStatus" asp-for="DisabilityStatus" class="form-check-input">
                    <label asp-for="DisabilityStatus" class="form-label me-2">Are you legally disabled?</label>
                </div>

            </div>

            <div class="row mb-3">
                <div class="col">
                    <input type="checkbox" id="PregnancyStatus" asp-for="PregnancyStatus" class="form-check-input">
                    <label asp-for="PregnancyStatus" class="form-label me-2">Are you pregnant?</label>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col">
                    <input type="checkbox" id="CaregiverStatus" asp-for="PrimaryCaregiverStatus" class="form-check-input">
                    <label asp-for="PrimaryCaregiverStatus" class="form-label me-2">Are you the primary caregiver of dependents?</label>
                    <button type="button"
                            class="btn p-0 border-0"
                            data-bs-toggle="popover"
                            data-bs-trigger="focus"
                            data-bs-title="Caregiver Status"
                            data-bs-placement="right"
                            data-bs-content="A primary caregiver is someone who provides the majority of care for a dependent,
                        such as a child, elderly person, or someone with a disability.
                        This may include tasks such as feeding, bathing, administering medication,
                        and providing emotional support.">
                        <span class="bi bi-info-circle"></span>
                    </button>

                </div>
            </div>

                    

            <div class="row mb-3">

                <div class="col-12 d-none" id="requiredDocsSection">
                </div>

                <label class="col-form-label col-md-3" for="Documentation">
                    Upload Documentation
                    <span>
                        <button type="button"
                                class="btn p-0 border-0 col-md-1"
                                data-bs-toggle="popover"
                                data-bs-trigger="focus"
                                data-bs-placement="right"
                                data-bs-title="Documentation"
                                data-bs-content="Please upload all required documentation for your application.
                            Required documentation depends on your specific circumstances. For instance, if you are pregnant, you may need to provide a doctor's note or medical records.
                            If you are a primary caregiver, you may need to provide legal documents or proof of guardianship. If you are disabled, you may need to provide medical records or a disability determination letter.
                            If you are employed, you may need to provide pay stubs or tax returns. If you are attending school, you may need to provide transcripts or enrollment verification.">

                            <span class="bi bi-info-circle"></span>
                        </button>
                    </span>
                </label>

                <input type="file" id="documentation" asp-for="Documents" multiple accept=".pdf, .jpg, .jpeg, .png, .doc, .docx" class="form-control">
                <div id="fileList" class="mt-2"></div>

            </div>

                        


            <div class="row mb-3">
                <div class="col  text-start">
                    <button class="btn btn-primary" type="submit">Submit</button>
                    <a asp-action="Index" class="btn btn-outline-danger">Cancel</a>
                </div>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    <script src="~/js/apply.js" asp-append-version="true"></script>
    <script src="~/js/apply-required-docs.js" asp-append-version="true"></script>
}