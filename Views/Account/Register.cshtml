@model RegisterViewModel


@{
    ViewBag.Title = "Register";
}

<div class="text-center mt-5">
    <h2>Register An Account</h2>
</div>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<form method="post" asp-action="Register">

    <div class="col-6 offset-4 mt-md-5">
        <div class="row mb-2">
            <label class="col-form-label">Enter Your First Name</label>
            <div class="col-md-7">
                <input asp-for="FirstName" class="form-control" />
            </div>
            <div class="col">
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
        </div>

        <div class="row mb-2">
            <label class="col-form-label">Enter Your Last Name</label>
            <div class="col-md-7">
                <input asp-for="LastName" class="form-control" />
            </div>
            <div class="col">
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
        </div>

        <div class="row mb-2">
            <label class="col-form-label">Create Username</label>
            <div class="col-md-7">
                <input asp-for="Username" class="form-control" />
            </div>
            <div class="col">
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>
        </div>

        <div class="row mb-2">
            <label class="col-form-label">Enter your Email Address</label>
            <div class="col-md-7">
                <input asp-for="Email" class="form-control" />
            </div>
            <div class="col">
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
        </div>

        <div class="row mb-2">
            <label class="col-form-label">Create Password</label>
            <div class="col-md-7">
                <input type="password" asp-for="Password" class="form-control" />
            </div>
            <div class="col">
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
        </div>

        <div class="row mb-2">
            <label class="col-form-label">Confirm Password</label>
            <div class="col-md-7">
                <input type="password" asp-for="ConfirmPassword" class="form-control" />
            </div>
            <div class="col">
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col">
                <button type="submit" class="btn btn-primary">Register</button>
                <a asp-action="Index" asp-controller="Home" class="btn btn-primary">Cancel</a>
            </div>
        </div>

        <div class="row">
            <div class="col offset-md-2">
                Already Registered? <a asp-action="Login">Log In</a>
            </div>
        </div>
    </div>
    

</form>